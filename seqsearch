         # Update the input file's errors.
         input_file_data.errors.append(error_message)


         return

      # check for new rows
      if len(df) < len(merge_dfs):

         print(f"## INTERNAL ERROR: row mismatch: {len(df)} < {len(merge_dfs)}")

