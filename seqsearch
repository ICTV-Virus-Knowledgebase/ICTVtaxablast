# Is this a valid nucleotide or amino acid sequence?
def is_valid_sequence(sequence: str) -> bool:

   # Validate as a nucleotide sequence.
   return set(sequence.upper()) <= VALID_NT or set(sequence.upper()) <= VALID_AA



