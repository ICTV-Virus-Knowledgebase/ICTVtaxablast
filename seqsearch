#---------------------------------------------------------------------------------------------------
# Decode a Base64URL-encoded file's basename that has a record number suffix an underscore and 
# the word "seq" followed by a 4 digit record number.
#---------------------------------------------------------------------------------------------------
def decode_file_basename(encoded_basename: str) -> str:

   # Trim and validate
   encoded_basename = encoded_basename.strip()
   if len(encoded_basename) < 1:
      return ""

   # If the basename ends with a suffix of the form "_seqNNNN" where NNNN is a 4 digit number, remove the suffix.
   if re.match(r".*_seq\d{4}$", encoded_basename) is not None:
      encoded_basename = encoded_basename[0:len(encoded_basename) - 8]
   
   length = len(encoded_basename)

   # Add enough padding to make the string length a multiple of 4.
   encoded_basename += "=" * ((4 * ceil(length/4)) - length)

   # The name is decoded as binary and needs to be converted to a UTF-8 string.
   return base64.urlsafe_b64decode(encoded_basename).decode("utf-8")


#---------------------------------------------------------------------------------------------------
# Generate a suffix for the basename based on the record number. 
# Note: The suffix will be an underscore and the word "seq" followed by a 4 digit record number.
#---------------------------------------------------------------------------------------------------
def generate_fasta_basename_suffix(recordNumber: int) -> str:
      
   digits = ""

   if recordNumber < 1000:
      if recordNumber >= 100:
         digits = "0"
      elif recordNumber >= 10: 
         digits = "00"
      else:
         digits = "000"

   return f"_seq{digits}{str(recordNumber)}"

   
#---------------------------------------------------------------------------------------------------
# Use blastdbcmd to determine the BLAST database title.
#---------------------------------------------------------------------------------------------------
def get_database_title() -> str:
   # if BLAST_TASK_PARAMETER_SETS.get(settings.task) == "blastn":
      # System command to get blast db info "blastdbcmd -db blast/ICTV_VMR_b -info"
   db_title_command = ["blastdbcmd", "-db", settings.db, "-info"]
   db_title_output = subprocess.run(db_title_command, capture_output=True, text=True, check=True)
   print("BLAST DB ", db_title_command)
   # else:
   #    # System command to get blast db info "blastdbcmd -db blast/ICTV_VMR_b -info"
   #    db_title_command = ["blastdbcmd", "-db", settings.db, "-info"]
   #    db_title_output = subprocess.run(db_title_command, capture_output=True, text=True, check=True)
   #    print("BLAST DB ", db_title_command)

   #Split the output into lines and take the first 4 lines with splicing
   db_title_len = db_title_output.stdout.splitlines()
   first_4_lines = db_title_len[:4]

   title = ""

   # Joins the first 4 lines by the tab characters
   if first_4_lines:
      title = " ".join(first_4_lines)
      title = title.strip()
      title = title[9:]  # remove the first 9 characters "Database: "
      title = title.strip()
   
   return title


