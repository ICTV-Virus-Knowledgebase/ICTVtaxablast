      split_files = split_input_files()
      if not split_files or len(split_files) < 1:
         raise Exception("No FASTA files were found for processing")

      # Process all FASTA files
      for split_file in split_files:
         process_fasta_file(split_file)

      # Add the file data lookup to the search results as a list.
      for filename in file_data_lookup:

         # Get the associated file data.
         file_data = file_data_lookup[filename]

         # Add it to the search results.
         search_results.files.append(file_data)

   except Exception as e:
      logging.error(f"The following error occurred: {str(e)}")

   # Create the JSON output file using search_results.
   create_json_file()


#---------------------------------------------------------------------------------------------------
# Process a single FASTA file and update the search results.
#---------------------------------------------------------------------------------------------------
def process_fasta_file(sequence_file: SequenceFile):

   global parsed_data_df
   global parsed_protein_data_df
   
   filename = sequence_file.get_filename()
   input_filename = sequence_file.get_input_filename()
   readable_filename = sequence_file.get_readable_filename()
   readable_input_filename = sequence_file.get_readable_input_filename()

   # Create a message specific to whether this is a split file and whether it's decoded.
   message = "Processing FASTA file "
   if not sequence_file.is_split:
      message += f"{input_filename}"
      if settings.decode_filenames:
         message += f" ({readable_input_filename})"
   else:
      message += f"{filename}"
      if settings.decode_filenames:
         message += f" ({readable_filename}) from input file {input_filename} ({readable_input_filename})"
      else:
         message += f" from input file {input_filename}"
   
   print(message)

   # Look for the input file's data in json_results. If it hasn't been added yet, create a new input file data object.
   if input_filename in file_data_lookup:
      input_file_data = file_data_lookup[input_filename]
   else:
      input_file_data = FileData(
         errors = [],
         name = readable_input_filename,
         sequences = []
      )
      
   try:
      # Run blastn on the FASTA file and generate ASN, CSV, and HTML output files.
      run_blast(filename)

   except RuntimeError as e:
      logging.error(str(e))

      # Update the input file's errors and add it back to the file data lookup.
      input_file_data.errors.append(str(e))
      file_data_lookup[input_filename] = input_file_data
      return

   # The output file paths for the blast results.
   blastcsv_output_filepath = f"{settings.outdir}/{filename}.csv"
   blasthtml_output_filepath = f"{settings.outdir}/{filename}.html"

   # Create a sequence data object.
   sequence_data = SequenceData(
      blast_csv = blastcsv_output_filepath,
      blast_html = blasthtml_output_filepath,
      errors = [],
      hits = [],
      input_file = readable_filename,
      qseqid = "",
      sequence_length = sequence_file.sequence_length,
      status = ""
   )

   # Keep track of the number of hits.
   hitCount = 0

   try:
      # Read in csv file and set headers to extract data. Process the file only if it's successfully read.
      df = pd.read_csv(blastcsv_output_filepath, header=0, names=CSV_COLUMNS)

      print(f"Loading CSV file {blastcsv_output_filepath}")
      print("Number of rows: ", len(df))
      print(f"Number of rows in {PROCESSED_ACCESSIONS_FILENAME}: ", len(parsed_data_df))
      if settings.task == "blastp":
         print(f"Number of rows in {PROCESSED_PROTEIN_ACCESSIONS_FILENAME}: ", len(parsed_protein_data_df))
      if settings.verbose: 
         print("CSV data:")
         print(df)

         print(f"{PROCESSED_ACCESSIONS_FILENAME} data:")
         print(parsed_data_df)

      # initializing the sBaseAccession column in df that is used for joining
      if settings.task == "blastp":
         # protein fasta headers end withe "-(genomeAccession).ver-(proteinAccession.ver)$"
         df["sBaseAccession"] = df["sseqid"].astype(str).str.replace(r'^.*-(\w[^.]*)\.[0-9]+-(\w[^.]*\..*)$', r'\1',regex=True)
         df["Protein_id"] = df["sseqid"].astype(str).str.replace(r'^.*-(\w[^.]*)\.[0-9]+-(\w[^.]*\..*)$', r'\2',regex=True)
      else:
         # nucleotide/genome fasta headers end withe "-(genomeAccession).ver$"
         if settings.task == "blastp":
            df["sBaseAccession"] = df["sseqid"].astype(str).str.replace(r'^.*-(?:[^-]*-)?([^.-]+)\..*$', r'\1', regex=True)
         else:
            df["sBaseAccession"] = df["sseqid"].astype(str).str.replace(r'^.*-(\w[^.]*)\..*$', r'\1', regex=True)
         
      # print sseqid to sBaseAccession mapping for debugging
      if settings.verbose:
         print("sseqid to sBaseAccession mapping:")
         for index, row in df.iterrows():
            if settings.task == "blastp":
               # print Protein_ID too, for blastp
               print(f"sseqid: {row['sseqid']} -> sBaseAccession: {row['sBaseAccession']}, Protein_id: {row['Protein_id']}")
            else: 
               # print w/o Protein_ID for blastn/dc-megablast/megablast since Protein_id is not populated
               print(f"sseqid: {row['sseqid']} -> sBaseAccession: {row['sBaseAccession']} ")
      

      merge_dfs = pd.merge(df, parsed_data_df, left_on="sBaseAccession", right_on= "Accession", how="left")
      if settings.task == "blastp":
         merge_dfs = pd.merge(merge_dfs, parsed_protein_data_df, left_on="Protein_id", right_on= "Protein_id", how="left", suffixes=("", "_protein"))
      if settings.verbose: print(merge_dfs,"\n")

      # check if some blast results didn't match known accessions
      merge_missing = merge_dfs["Species"].isna().sum()
      if merge_missing > 0:

         # dump ofending data frames
         tsv_name= "debug.df.tsv"
         print(f"## INTERNAL ERROR: row mismatch: {tsv_name}, will have {len(df)} lines")
         df.to_csv(tsv_name, sep="\t", index=False)
