         c_df     = df["sBaseAccession"].dropna().value_counts()
         c_merged = merge_dfs["sBaseAccession"].dropna().value_counts()

         # accessions with different row counts post-merge than pre-merge
         #changed_accessions = sorted([acc for acc, n in c_merged.items() if n !=  c_df.get(acc, 0)])
         df_map     = dict(c_df)        # index -> count
         merged_map = dict(c_merged)    # index -> count
         changed_accessions = sorted(
                [("+" if merged_map.get(acc,0) > df_map.get(acc,0) else "-") + acc
                 for acc in set(merged_map) | set(df_map)
                 if merged_map.get(acc,0) != df_map.get(acc,0)]
         )
         print("changed_accessions:")
         print(changed_accessions)
         problem_accessions_str = ", ".join(changed_accessions)

