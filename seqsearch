#---------------------------------------------------------------------------------------------------
# A FASTA file containing a single sequence.
#---------------------------------------------------------------------------------------------------
class SequenceFile():

   # The input file's extension (suffix).
   extension: str 

   # The input file's base name (stem).
   input_basename: str

   # Was this file split from the input file?
   is_split: bool

   # A readable version of the input file's base name. This will be the same as the input base name if
   # settings.decode_filenames is False. Otherwise, this will be the decoded basename of the input file.
   readable_basename: str

   # The length of the file's FASTA sequence.
   sequence_length: int

   # For files with multiple sequences/records, this is the record's index in the original input file.
   sequence_number: int | None

   # For split files, the text added to the base filename.
   split_identifier: str|None


   # C-tor
   def __init__(self, input_filename: str, is_split: bool, sequence_length: int, sequence_number: int | None = None):

      self.is_split = is_split
      self.sequence_length = sequence_length
      self.sequence_number = sequence_number

      input_path = Path(input_filename)

      # Get the input file's basename and extension.
      self.input_basename = input_path.stem
      self.extension = input_path.suffix

      # Determine the "readable" version of the input file's base name.
      self.readable_basename = self.input_basename if not settings.decode_filenames else decode_file_basename(self.input_basename)
      
   #---------------------------------------------------------------------------------------------------
   # Get the sequence filename
   #---------------------------------------------------------------------------------------------------
   def get_filename(self) -> str:

      suffix = "" if self.sequence_number == None else generate_fasta_basename_suffix(self.sequence_number)

      return f"{self.input_basename}{suffix}{self.extension}"
   
   #---------------------------------------------------------------------------------------------------
   # Get the input filename
   #---------------------------------------------------------------------------------------------------
   def get_input_filename(self) -> str:
      return f"{self.input_basename}{self.extension}"
   
   #---------------------------------------------------------------------------------------------------
   # Get a readable version of the sequence filename.
   #---------------------------------------------------------------------------------------------------
   def get_readable_filename(self) -> str:

      suffix = "" if self.sequence_number == None else generate_fasta_basename_suffix(self.sequence_number)

      return f"{self.readable_basename}{suffix}{self.extension}"
   
   # Get a readable version of the input filename.
   def get_readable_input_filename(self) -> str:
      return f"{self.readable_basename}{self.extension}"
   

