# Build the base blastn command for this run.
#---------------------------------------------------------------------------------------------------
def build_blastasn_base_cmd() -> list[str]:

   if settings.task not in BLAST_TASK_PARAMETER_SETS:
      raise RuntimeError(f"Invalid BLAST task: {settings.task}")

   task_parameters = BLAST_TASK_PARAMETER_SETS[settings.task]
   command: list[str] = [settings.task]
   for option, value in task_parameters:
      command.extend([option, value])

   command.extend([
      "-max_target_seqs", str(settings.max_target_seqs),
      "-max_hsps", str(settings.max_hsps),
      "-db", settings.db,
      "-outfmt", "11"
   ])

   return command


#---------------------------------------------------------------------------------------------------
# Run blast on a FASTA file and generate ASN, CSV, and HTML output files.
#---------------------------------------------------------------------------------------------------
def run_blast(filename: str):

   global search_results

   print(f"\nRunning blast ({settings.task}) on {filename}")
   
   # Create file names/paths for the output files.
   blastasn_output_filepath = f"{settings.outdir}/{filename}.asn"
   blastcsv_output_filepath = f"{settings.outdir}/{filename}.csv"
   blasthtml_output_filepath = f"{settings.outdir}/{filename}.html"

   print(f"CSV output path: {blastcsv_output_filepath}")
   print(f"HTML output path: {blasthtml_output_filepath}")

   # The FASTA file's full path.
   fasta_path = f"{settings.indir}/{SEQUENCE_FILES_DIR}/{filename}"

   command_str = ""

   try:
      if not blastasn_base_cmd:
         raise RuntimeError("Base BLAST command has not been initialized")

      blastasn_cmd = blastasn_base_cmd.copy()
      blastasn_cmd.extend([
         "-query", fasta_path,
         "-out", blastasn_output_filepath
      ])

      command_str = " ".join(shlex.quote(arg) for arg in blastasn_cmd)
      print("BLAST COMMAND:" + command_str)

      # Run blast on the FASTA file and generate an ASN file.
      subprocess.run(blastasn_cmd, capture_output=True, text=True, check=True)

   except subprocess.CalledProcessError as e:
      raise RuntimeError(f"Runtime error from blast command: {e.stderr}")
   except Exception as ex:
      raise RuntimeError(f"Error running blast command: {str(ex)}")

   # Generate the CSV output file.
   try:
      blastcsv_cmd = ["blast_formatter", "-archive", str(blastasn_output_filepath), "-out", blastcsv_output_filepath, "-outfmt", "10"]
      print(" ".join(blastcsv_cmd))

      subprocess.run(blastcsv_cmd, capture_output=True, text=True, check=True)

      # Add a header row to the CSV file.
      df = pd.read_csv(blastcsv_output_filepath, header=None)
      df.columns = BLAST_RESULT_COLUMNS
      df[CSV_METADATA_COLUMNS[0]] = command_str
      df[CSV_METADATA_COLUMNS[1]] = search_results.version
      df[CSV_METADATA_COLUMNS[2]] = search_results.database_title
      df = df[CSV_COLUMNS]
      df.to_csv(blastcsv_output_filepath, index=False)

   except subprocess.CalledProcessError as e:
      logging.error(f"\"Called process\" error in blast_formatter's (CSV) command: {e.stderr}")
      return
   except Exception as ex:
      logging.error(f"Error running blast_formatter (CSV) command: {str(ex)}")
      return
   
   # Generate the HTML output file.
   try:
      blasthtml_cmd = ["blast_formatter", "-archive", blastasn_output_filepath, "-out", blasthtml_output_filepath, "-html"]
      print(" ".join(blasthtml_cmd))

      subprocess.run(blasthtml_cmd, capture_output=True, text=True, check=True)

   except subprocess.CalledProcessError as e:
      logging.error(f"Runtime error from blast_formatter (HTML) command: {e.stderr}")
      return
   except Exception as ex:
      logging.error(f"Error running blast_formatter (HTML) command: {str(ex)}")
      return
   

#---------------------------------------------------------------------------------------------------
# Split FASTA files when there is more than one sequence in the file.
#---------------------------------------------------------------------------------------------------
def split_input_files() -> list[SequenceFile] | None:
   
   print("\nSplitting input file(s)")

   # The collection of sequence file objects that will be returned.
   sequence_files: list[SequenceFile] = []

   # Keep track of the total number of sequences we find.
   sequence_count = 0

   # Create a path object from the input directory.
   input_directory = Path(settings.indir)
   
   # Create the SEQUENCE_FILES_DIR subdirectory.
   seq_files_path = input_directory / SEQUENCE_FILES_DIR
   seq_files_path.mkdir(exist_ok=True)

   # Iterate over all files in the input directory.
   for input_file in input_directory.iterdir():

      # Make sure the file has a valid extension for a FASTA file.
      if input_file.suffix.lower() not in FASTA_FILE_EXTENSIONS:
         continue

      # Parse the input file for FASTA sequences.
      sequences: list[SeqRecord.SeqRecord] = list(SeqIO.parse(input_file, "fasta"))
      if sequences is None or len(sequences) < 1:
         continue

      print(f"Found {len(sequences)} sequence(s) in {input_file.name}\n")

      # Update the total sequence count.
      sequence_count += len(sequences)

      if sequence_count > MAX_SEQUENCES:
         raise Exception(f"You uploaded more than the maximum number of sequences ({MAX_SEQUENCES})")
      
      # Don't split the file if it only has one sequence.
      if len(sequences) == 1:

         is_split = False

         # Get the sequence
         sequence = sequences[0]
         if sequence is None or sequence.seq is None:
            continue

         # Does the sequence have valid bases?
         if not is_valid_sequence(str(sequence.seq)):
            logging.error(f"Sequence {input_file.name} has invalid bases")
            continue

         # Add a SequenceFile object for the input file.
         sequence_files.append(SequenceFile(input_file.name, is_split, len(sequence.seq)))

         # Copy the file to the sequence_files subdirectory.
         shutil.copy2(input_file, seq_files_path / input_file.name)
         continue

      # Iterate over all sequences in the FASTA file.
      for s, sequence in enumerate(sequences, start=1):

         is_split = True

         if sequence is None or sequence.seq is None:
            continue

         # Does the sequence have valid bases?
         if not is_valid_sequence(str(sequence.seq)):
            logging.error(f"Sequence {s} in {input_file.name} has invalid bases")
            continue

         # Create a sequence file object for the split file.
         sequence_file = SequenceFile(input_file.name, is_split, len(sequence.seq), s)

         # Create a path for the sequence file.
         sequence_path = seq_files_path / sequence_file.get_filename()

         # Create the new FASTA file and populate it with the single sequence.
         SeqIO.write(sequence, sequence_path, "fasta")

         # Add the collection of sequence files.
         sequence_files.append(sequence_file)

   return sequence_files



